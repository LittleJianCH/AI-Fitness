cabal-version: 3.0
name: ai-fitness-backend
version: 0.1.0.0
build-type: Simple

common backend-settings
  hs-source-dirs: .
  build-depends: base, ihp, servant, servant-server, text, time, uuid-types, vector, wai, warp, aeson, bytestring, http-api-data, http-types, lens, openapi3, servant-openapi3, wai-extra, hasql, hasql-th >=0.5 && <0.6, hasql-transaction, profunctors, transformers, crypton, memory, cookie, hasql-pool, uuid, containers, network, network-uri
  cxx-sources: native/fit_adapter.cpp
  include-dirs: native
  cxx-options: -std=c++17 -Wall -Wextra
  pkgconfig-depends: fitsdk == 21.214.0
  default-language: Haskell2010
  ghc-options: -Wall -threaded -rtsopts
  other-modules: Api,
                 Config,
                 Workout.Common.Empty,
                 Workout.Common.Types,
                 Workout.Common.Validation,
                 Workout.Cycling.Empty,
                 Workout.Cycling.Types,
                 Workout.Cycling.Update,
                 Workout.Cycling.Validation,
                 Workout.Empty,
                 Workout.Identity.Types,
                 Workout.Measurement.Summary,
                 Workout.Measurement.Types,
                 Workout.Measurement.Validation,
                 Workout.Running.Empty,
                 Workout.Running.Types,
                 Workout.Running.Update,
                 Workout.Running.Validation,
                 Workout.Sport.Types,
                 Workout.Sport.Validation,
                 Workout.Sport,
                 Workout.Types,
                 Workout.Update,
                 Workout.Validation.Types,
                 Workout.Validation,
                 Import.Fit,
                 Import.Fit.Decode,
                 Import.Fit.Normalize,
                 Import.Fit.Types,
                 Import.Output,
                 Import.State,
                 Import.Types,
                 Api.Auth.Context,
                 Api.Auth.Handlers,
                 Api.Boundary,
                 Api.Error,
                 Api.Pagination,
                 App.Types,
                 App.Environment,
                 Auth.Password,
                 Auth.Token,
                 Auth.Request,
                 Auth.Session,
                 Api.Auth.Routes,
                 Api.Auth.Types,
                 Api.Binary,
                 Api.Codec,
                 Api.Common.Routes,
                 Api.Common.Types,
                 Api.Export.Routes,
                 Api.Export.Types,
                 Api.Import.Routes,
                 Api.Import.Types,
                 Api.OpenApi,
                 Api.Scalar,
                 Api.Types,
                 Api.Workout.Codec,
                 Api.Workout.Handlers,
                 Api.Workout.Common.Codec,
                 Api.Workout.Cycling.Codec,
                 Api.Workout.Identity.Codec,
                 Api.Workout.Measurement.Codec,
                 Api.Workout.Routes,
                 Api.Workout.Running.Codec,
                 Api.Workout.Types,
                 Api.WorkoutGroup.Routes,
                 Api.WorkoutGroup.Types,
                 Storage.Codec,
                 Storage.Database,
                 Storage.Types,
                 Storage.User,
                 Storage.User.Types,
                 Storage.Session,
                 Storage.Session.Types,
                 Storage.Workout,
                 Storage.Workout.Types,
                 Storage.Workout.Query,
                 Storage.Workout.Submission

executable ai-fitness-backend
  import: backend-settings
  main-is: Main.hs

executable export-openapi
  import: backend-settings
  main-is: contract/Main.hs

test-suite api-contract
  import: backend-settings
  type: exitcode-stdio-1.0
  hs-source-dirs: contract, test
  main-is: Check.hs
  other-modules: ContractFixtures, Fixtures

test-suite storage
  import: backend-settings
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: storage/Main.hs
  build-depends: async
  other-modules: Fixtures

test-suite http
  import: backend-settings
  type: exitcode-stdio-1.0
  hs-source-dirs: test, test/http
  main-is: http/Main.hs
  build-depends: async
  other-modules: AuthChecks, AuthRaceChecks, InputChecks, HttpSupport, WorkoutChecks, RestartChecks, Fixtures
