    "Single workout · W · Includes recorded zeros. Samples up to %lld seconds apart are linearly interpolated; longer gaps break the interval without zero filling or extrapolation. Duration uses a logarithmic axis and connecting lines are reading guides. Interval times are relative to workout start.": {
      "comment": "Application-owned iOS interface text. Keep identifiers, values and metric units unchanged.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Single workout · W · Includes recorded zeros. Samples up to %lld seconds apart are linearly interpolated; longer gaps break the interval without zero filling or extrapolation. Duration uses a logarithmic axis and connecting lines are reading guides. Interval times are relative to workout start."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单次训练 · W · 包含真实零值。间隔最多 %lld 秒时线性插值，更长缺口切断区间，不补零或外推。横轴为持续时长（对数），连线仅辅助阅读；区间时间相对训练开始。"
          }
        }
      }
    },
    "%@ and above": {
      "comment": "Unbounded measurement zone, including its unit.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ and above"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 以上"
          }
        }
      }
    },
    "Heart rate coverage is below 95%; the load below covers only the observed portion": {
      "comment": "Application-owned iOS interface text. Keep identifiers, values and metric units unchanged.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Heart rate coverage is below 95%; the load below covers only the observed portion"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "心率覆盖不足 95%，以下仅为已观测部分的负荷"
          }
        }
      }
    },
    "Zone boundaries are 55%, 75%, 90%, 105%, 120% and 150% of threshold power. Only valid power coverage is included.": {
      "comment": "Application-owned iOS interface text. Keep identifiers, values and metric units unchanged.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Zone boundaries are 55%, 75%, 90%, 105%, 120% and 150% of threshold power. Only valid power coverage is included."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "阈值功率的 55%、75%、90%、105%、120%、150% 为区间边界。只计入有效功率覆盖。"
          }
        }
      }
    },
    "Zones use heart rate reserve boundaries of 50%, 60%, 70%, 80% and 90%. Z0 is below 50%; Z6 is at or above the configured maximum heart rate. Readings above maximum are excluded from load.": {
      "comment": "Application-owned iOS interface text. Keep identifiers, values and metric units unchanged.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Zones use heart rate reserve boundaries of 50%, 60%, 70%, 80% and 90%. Z0 is below 50%; Z6 is at or above the configured maximum heart rate. Readings above maximum are excluded from load."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "区间按心率储备划分：50%、60%、70%、80%、90%。Z0 低于 50%；Z6 为达到或超过配置的最大心率。超出最大心率的读数不计入负荷。"
          }
        }
      }
    },
