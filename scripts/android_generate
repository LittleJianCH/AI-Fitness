#!/usr/bin/env python3
"""Generate Android DTOs/codecs from the backend OpenAPI artifact; no schema copy."""
import argparse
import json
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
parser = argparse.ArgumentParser()
parser.add_argument('--schema', type=Path, default=ROOT / 'contracts/build/openapi.json')
parser.add_argument('--output', type=Path, default=ROOT / 'android/app/build/generated/contract/com/aifitness/contract/Contract.kt')
args = parser.parse_args()
schemas = json.loads(args.schema.read_text())['components']['schemas']
roots = ['UserSettings', 'Workout', 'Page_WorkoutCard', 'WorkoutAnalysis', 'PowerCurve',
         'TrainingHistory', 'TrainingHistoryRequest', 'NativeSession', 'User', 'Page_Session', 'Problem']
selected = {}

def visit(name):
    if name in selected:
        return
    schema = schemas[name]
    selected[name] = schema
    def refs(node):
        if isinstance(node, dict):
            if '$ref' in node:
                visit(node['$ref'].split('/')[-1])
            for value in node.values(): refs(value)
        elif isinstance(node, list):
            for value in node: refs(value)
    refs(schema)
for root in roots: visit(root)

# Inline alternatives become named types scoped by their enclosing union.
for name, schema in list(selected.items()):
    for choice in schema.get('oneOf', []):
        selected[name + choice['title']] = choice

primitive = {'string': 'String', 'number': 'Double', 'integer': 'Long', 'boolean': 'Boolean'}
def ref(s): return s['$ref'].split('/')[-1]
def kind(s):
    if '$ref' in s: return ref(s)
    if s.get('type') == 'array': return 'List<' + kind(s['items']) + '>'
    return primitive[s['type']]
def decode(s, value):
    if '$ref' in s:
        name = ref(s)
        target = selected[name]
        if 'properties' in target or 'oneOf' in target: return f'{name}.fromJson(objectValue({value}))'
        if 'enum' in target: return f'{name}.fromWire(stringValue({value}))'
        return decode(target, value)
    typ = s['type']
    if typ == 'array': return f'arrayValue({value}).map {{ element -> {decode(s["items"], "element")} }}'
    if typ == 'string':
        result = f'stringValue({value})'
        if s.get('pattern'): result += '.also { require(Regex(' + json.dumps(s['pattern']) + ').matches(it)) { "Invalid contract string" } }'
        if s.get('format') == 'date-time': result += '.also { parseInstant(it) }'
        if s.get('format') == 'uuid': result += '.also { require(it.length == 36); java.util.UUID.fromString(it) }'
        if s.get('enum'): result += '.also { require(it in listOf(' + ', '.join(json.dumps(x) for x in s['enum']) + ')) }'
        return result
    return {'number': 'numberValue', 'integer': 'integerValue', 'boolean': 'booleanValue'}[typ] + '(' + value + ')'
def encode(s, value):
    if '$ref' in s:
        target = selected[ref(s)]
        if 'properties' in target or 'oneOf' in target: return value + '.toJson()'
        if 'enum' in target: return value + '.wire'
        return encode(target, value)
    if s.get('type') == 'array': return 'JSONArray(' + value + '.map { element -> ' + encode(s['items'], 'element') + ' })'
    return value
lines = ['// Generated by scripts/android_generate. Do not edit or commit.',
         'package com.aifitness.contract', 'import org.json.JSONArray', 'import org.json.JSONObject', '']
for name, schema in sorted(selected.items()):
    if 'oneOf' in schema:
        choices = schema['oneOf']
        lines += [f'sealed interface {name} {{', '    fun toJson(): JSONObject', '    companion object {',
                  f'        fun fromJson(json: JSONObject): {name} = when (stringValue(json.get("type"))) {{']
        for choice in choices:
            tag = choice['properties']['type']['enum'][0]
            lines += [f'            "{tag}" -> {name}{choice["title"]}.fromJson(json)']
        lines += ['            else -> error("Unsupported contract alternative")', '        }', '    }', '}']
    elif 'properties' in schema:
        fields = schema['properties']
        required = schema.get('required', [])
        parents = [p for p, s in selected.items() if schema in s.get('oneOf', [])]
        lines += [f'data class {name}(']
        for key, shape in fields.items():
            lines += [f'    val {key}: {kind(shape)}' + ('' if key in required else '? = null') + ',']
        lines += [')' + (f' : {parents[0]}' if parents else '') + ' {', '    ' + ('override ' if parents else '') + 'fun toJson(): JSONObject = JSONObject().apply {']
        for key, shape in fields.items():
            if key in required: lines += [f'        put("{key}", {encode(shape, key)})']
            else: lines += [f'        {key}?.let {{ value -> put("{key}", {encode(shape, "value")}) }}']
        lines += ['    }', '    companion object {', f'        fun fromJson(json: JSONObject): {name} = {name}(']
        for key, shape in fields.items():
            expression = decode(shape, f'json.get("{key}")')
            if key not in required: expression = f'if (json.has("{key}")) {expression} else null'
            lines += [f'            {key} = {expression},']
        lines += ['        )', '    }', '}']
    elif 'enum' in schema:
        lines += [f'enum class {name}(val wire: String) {{', ',\n'.join(f'    {v}("{v}")' for v in schema['enum']) + ';',
                  '    companion object {', f'        fun fromWire(value: String): {name} = entries.firstOrNull {{ it.wire == value }}',
                  '            ?: error("Unsupported contract enum")', '    }', '}']
    else:
        lines += [f'typealias {name} = {kind(schema)}']
    lines += ['']
lines += ['''internal fun objectValue(value: Any): JSONObject = value as? JSONObject ?: error("Expected object")
internal fun stringValue(value: Any): String = value as? String ?: error("Expected string")
internal fun booleanValue(value: Any): Boolean = value as? Boolean ?: error("Expected boolean")
internal fun numberValue(value: Any): Double = (value as? Number)?.toDouble()?.also {
    require(it.isFinite()) { "Expected finite number" }
} ?: error("Expected number")
internal fun integerValue(value: Any): Long {
    require(value is Number && Regex("-?(0|[1-9][0-9]*)").matches(value.toString()))
    return value.toString().toLong()
}
internal fun arrayValue(value: Any): List<Any> {
    val array = value as? JSONArray ?: error("Expected array")
    return List(array.length()) { array.get(it) }
}
// Preserve wire precision in DTO strings; display/calendar operations use native nanoseconds.
fun parseInstant(value: String): java.time.Instant = java.time.Instant.parse(
    value.replace(Regex("(\\\\.\\\\d{9})\\\\d+(?=Z|[+-])"), "$1"),
)
''']
args.output.parent.mkdir(parents=True, exist_ok=True)
args.output.write_text('\n'.join(lines))
print(f'Generated {len(selected)} contract types from backend OpenAPI.')
