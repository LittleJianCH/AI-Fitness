#!/usr/bin/env bash
set -euo pipefail
repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
if [[ "${AI_FITNESS_WEB_TEST_SHELL:-}" != 1 ]]; then
    cd "$repo_root"
    exec nix develop path:. --accept-flake-config --no-update-lock-file -c env AI_FITNESS_WEB_TEST_SHELL=1 "$repo_root/scripts/web_integration_test" "$@"
fi
unset PGHOSTADDR PGSERVICE PGSERVICEFILE PGOPTIONS MINIMUM_REVISION
# Ignore existing database/session settings. Every run owns a disposable cluster.
test_root=$(mktemp -d /tmp/ai-fitness-web.XXXXXX)
cleanup() {
    pg_ctl -D "$test_root/data" -m immediate -w stop >/dev/null 2>&1 || true
    rm -rf -- "$test_root"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
cd "$repo_root"
make -C backend all >"$test_root/build.log" 2>&1 || { cat "$test_root/build.log"; exit 1; }
node --input-type=module - <<'JS'
import net from 'node:net';
for (const [port, host] of [[8181, '127.0.0.1'], [5181, 'localhost']]) {
 const server = net.createServer();
 await new Promise((resolve, reject) => { server.once('error', reject); server.listen(port, host, resolve); });
 await new Promise(resolve => server.close(resolve));
}
JS
mkdir "$test_root/socket"
initdb -D "$test_root/data" --username=fitness_web_test --no-locale --encoding=UTF8 --auth-local=trust --auth-host=reject >"$test_root/init.log"
pg_ctl -D "$test_root/data" -l "$test_root/postgres.log" -o "-k $test_root/socket -c listen_addresses=''" -w start >/dev/null
createdb -h "$test_root/socket" -p 5432 -U fitness_web_test fitness_web_test
export DATABASE_URL="host=$test_root/socket port=5432 dbname=fitness_web_test user=fitness_web_test"
export APP_ORIGIN='https://localhost:5181' PORT=8181 REGISTRATION_OPEN=true
export ARGON_MEMORY_KIB=19456 ARGON_ITERATIONS=2
(cd backend && IHP_MIGRATION_DIR=Application/Migration/ migrate) >"$test_root/migrate.log" 2>&1 || { cat "$test_root/migrate.log"; exit 1; }
export AI_FITNESS_WEB_TEST_DATABASE_URL="$DATABASE_URL"
umask 077
openssl req -x509 -newkey rsa:2048 -nodes -days 1 -subj '/CN=localhost' -addext 'subjectAltName=DNS:localhost' -keyout "$test_root/key.pem" -out "$test_root/cert.pem" 2>/dev/null
export AI_FITNESS_TLS_CERT="$test_root/cert.pem" AI_FITNESS_TLS_KEY="$test_root/key.pem" AI_FITNESS_API_TARGET='http://127.0.0.1:8181'
cd web
pnpm exec playwright test --config playwright.connected.config.ts "$@"
